#include <windows.h>

// Embedded PNGs for LC / RH / RIDE icons.
//
// Generated by CMake `configure_file()` so the PNG paths are absolute and stable.

#define IDR_PNG_MOVE 101
#define IDR_PNG_FIRE 102
#define IDR_PNG_RIDE 103

IDR_PNG_MOVE RCDATA "@PIPELA_ASSET_ARROW_PNG@"
IDR_PNG_FIRE RCDATA "@PIPELA_ASSET_GUNFIRE_PNG@"
IDR_PNG_RIDE RCDATA "@PIPELA_ASSET_CHOPPER_PNG@"

