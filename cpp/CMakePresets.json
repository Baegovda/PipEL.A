{
  "version": "6",
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "bridge",
      "displayName": "Pipela pybind bridge (parity only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bridge",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIPELA_BUILD_QT_APP": "OFF",
        "PIPELA_BUILD_NATIVE_HUD": "OFF",
        "PIPELA_BUILD_PYBIND": "ON",
        "PIPELA_ENABLE_OPENCV": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Pipela C++ Release (product)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIPELA_BUILD_QT_APP": "ON",
        "PIPELA_BUILD_PYBIND": "OFF",
        "PIPELA_BUILD_NATIVE_HUD": "ON",
        "PIPELA_ENABLE_OPENCV": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "bridge",
      "configurePreset": "bridge"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
