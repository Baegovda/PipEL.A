{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Pipela C++ Dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PIPELA_BUILD_QT_APP": "ON",
        "PIPELA_BUILD_PYBIND": "ON",
        "PIPELA_ENABLE_OPENCV": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Pipela C++ Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIPELA_BUILD_QT_APP": "ON",
        "PIPELA_BUILD_PYBIND": "ON",
        "PIPELA_ENABLE_OPENCV": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
